{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-decorations",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "dialog:allow-open",
    "dialog:allow-save",
    "window-state:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "global-shortcut:allow-register",
    "log:default",
    "allow-set-key-recording",
    "allow-export-layout-html",
    "allow-export-layout-folder",
    "allow-get-press-log",
    "allow-export-verification-session",
    "allow-load-config",
    "allow-save-config",
    "allow-get-app-paths",
    "allow-list-backups",
    "allow-restore-config-from-backup",
    "allow-export-full-config",
    "allow-import-full-config-preview",
    "allow-import-full-config-apply",
    "allow-open-config-folder",
    "allow-accept-portable-migration",
    "allow-parse-synapse-source",
    "allow-import-synapse-into-config",
    "allow-set-input-capture-mode",
    "allow-live-map-ready",
    "allow-start-runtime",
    "allow-stop-runtime",
    "allow-reload-runtime",
    "allow-set-native-texts",
    "allow-rehook-capture",
    "allow-get-debug-log",
    "allow-get-log-directory",
    "allow-open-log-directory",
    "allow-is-running-as-admin",
    "allow-relaunch-as-admin",
    "allow-get-admin-autostart-status",
    "allow-set-admin-autostart",
    "allow-capture-active-window",
    "allow-list-running-processes",
    "allow-list-bundled-presets",
    "allow-read-bundled-preset",
    "allow-preview-resolution",
    "allow-execute-preview-action",
    "allow-run-preview-action",
    "allow-live-test-action",
    "allow-get-exe-icon",
