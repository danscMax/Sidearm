    "allow-get-menu-usage",
    "allow-export-snippets",
    "allow-import-device-image",
    "allow-read-device-image",
    "allow-delete-device-image",
    "allow-start-macro-recording",
    "allow-record-keystroke",
    "allow-stop-macro-recording",
    "allow-apply-onboard-mapping",
    "allow-verify-onboard-mapping",
    "allow-restore-onboard-control",
    "allow-get-synapse-status",
    "allow-recover-from-synapse",
    "allow-restore-synapse-startup",
    "allow-get-native-model",
    "allow-list-native-mice",
    "allow-get-onboard-banks",
    "allow-get-offline-preview",
    "allow-get-device-report",
    "allow-open-device-report-issue",
    "allow-get-mouse-status",
    "allow-set-key-signals",
    "allow-open-startup-apps-settings",
    "allow-get-mouse-settings",
    "allow-set-mouse-dpi",
    "allow-set-mouse-poll-rate"
